{
  "name": "shs-server",
  "version": "1.0.0",
  "description": "API and scan worker for the Security Header Scanner",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "test": "node --import ./tests/setup.js --test --test-concurrency=1",
    "test:coverage": "node --import ./tests/setup.js --test --test-concurrency=1 --experimental-test-coverage"
  },
  "dependencies": {
    "bullmq": "^5.81.5",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
