# Copy to .env to override defaults. docker compose reads this file automatically.

# Ports published by docker compose
CLIENT_PORT=8090
API_PORT=5060

# Server and worker
NODE_ENV=development
PORT=5060
MONGO_URI=mongodb://mongo:27017/shs
REDIS_URL=redis://redis:6379
CLIENT_ORIGIN=http://localhost:8090
# Reverse proxies in front of the API (1 for nginx in Docker, 0 when run directly)
TRUST_PROXY=0

# Scanner behaviour
SCAN_CACHE_TTL=600
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW=60
SCAN_TIMEOUT_MS=10000
WORKER_CONCURRENCY=5
